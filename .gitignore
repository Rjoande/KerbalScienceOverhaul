# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.code-workspace

# Temp / backup
*.tmp
*.bak
*.backup
*.orig
*~

# Logs
*.log

# Archives (if you generate release packages locally)
*.zip
*.7z
*.rar

# CKAN tooling (local netkan inflate tests; the .netkan itself stays tracked)
netkan.exe
ckan.exe
*.ckan

# ModuleManager output, if GameData is ever loaded by a test install
ModuleManager.ConfigCache
ModuleManager.ConfigSHA
ModuleManager.Physics
ModuleManager.TechTree

# Plugin build intermediates (Source/KSOScienceResults; Directory.Build.props keeps them out of the repo anyway)
Source/**/bin/
Source/**/obj/
Source/**/.vs/

# Local workspace (session hub and notes, not part of the mod)
/CLAUDE.md
/notes/
/.claude/
